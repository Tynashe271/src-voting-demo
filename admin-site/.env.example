APP_NAME="SRC Elections Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# The Go voting backend's shared Postgres database (repo-root migrations/ owns this schema).
# Only App\Models\AdminAccount and App\Models\AdminAuditLog use this connection. Use the
# voting_admin_portal_login credential from ../deploy/roles.example.sql here, never the
# migration/owner credentials.
DB_VOTING_HOST=postgres
DB_VOTING_PORT=5432
DB_VOTING_DATABASE=voting
DB_VOTING_USERNAME=voting_admin_portal_login
DB_VOTING_PASSWORD=replace-with-a-local-development-password

# A separate, privileged credential used ONLY by `php artisan admin:create-account`, never by the
# running application. Leave unset unless you are about to provision a staff account.
# DB_VOTING_PROVISION_USERNAME=
# DB_VOTING_PROVISION_PASSWORD=

# The Go voting backend's internal admin API. This key is a service-to-service credential, never a
# staff login — it must be the same value as INTERNAL_ADMIN_API_KEY in the repo-root .env, and it
# must never be sent to a browser.
VOTING_API_BASE_URL=http://localhost:8080/api/v1/admin
VOTING_API_KEY=replace-with-the-same-value-as-repo-root-INTERNAL_ADMIN_API_KEY

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
